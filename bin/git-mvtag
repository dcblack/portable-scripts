#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

readonly VERSION='0.1.0'

usage() {
  cat <<'EOF'
NAME
    git-mvtag - rename an annotated Git tag

SYNOPSIS
    git-mvtag [--push] OLDNAME NEWNAME

DESCRIPTION
    Renames an existing local annotated tag while preserving its target,
    message, tagger, and tagger date. With --push, remotes containing OLDNAME
    are updated by deleting OLDNAME and pushing NEWNAME.

OPTIONS
    --push       Update remotes where OLDNAME is already present.
    -h, --help   Display this help text.
    -V, --version
                 Display the version.
EOF
}

error() {
  printf 'git-mvtag: %s\n' "$1" >&2
  exit 1
}

push_remote_tags() {
  local old_name="$1"
  local new_name="$2"
  local remote
  local remotes

  remotes="$(git remote)"
  while IFS= read -r remote; do
    [[ -n "${remote}" ]] || continue
    if git ls-remote --exit-code --refs "${remote}" "refs/tags/${old_name}" \
      >/dev/null 2>&1; then
      printf 'Updating remote %s...\n' "${remote}"
      git push "${remote}" ":refs/tags/${old_name}"
      git push "${remote}" "refs/tags/${new_name}"
    fi
  done <<<"${remotes}"
}

push=false
while (($# > 0)); do
  case "$1" in
    --push)
      push=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -V | --version)
      printf 'git-mvtag %s\n' "${VERSION}"
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -* )
      error "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -eq 2 ]] || error 'usage: git-mvtag [--push] OLDNAME NEWNAME'
old_name="$1"
new_name="$2"

git rev-parse --verify --quiet "refs/tags/${old_name}^{tag}" \
  >/dev/null || error "'${old_name}' does not exist or is not an annotated tag"
git check-ref-format "refs/tags/${new_name}" \
  >/dev/null 2>&1 || error "invalid new tag name: '${new_name}'"
git show-ref --verify --quiet "refs/tags/${new_name}" && \
  error "tag '${new_name}' already exists"

tag_file="$(mktemp "${TMPDIR:-/tmp}/git-mvtag.XXXXXX")"
trap 'rm -f -- "${tag_file}"' EXIT
git for-each-ref --format='%(contents)' "refs/tags/${old_name}" >"${tag_file}"

export GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE
GIT_COMMITTER_NAME="$(git for-each-ref --format='%(taggername)' "refs/tags/${old_name}")"
GIT_COMMITTER_EMAIL="$(git for-each-ref --format='%(taggeremail)' "refs/tags/${old_name}")"
GIT_COMMITTER_DATE="$(git for-each-ref --format='%(taggerdate:raw)' "refs/tags/${old_name}")"

git tag --annotate --no-sign --file="${tag_file}" "${new_name}" \
  "${old_name}^{}"
git tag --delete "${old_name}" >/dev/null

if [[ "${push}" == true ]]; then
  push_remote_tags "${old_name}" "${new_name}"
fi

printf "Renamed annotated tag '%s' to '%s'.\n" "${old_name}" "${new_name}"
