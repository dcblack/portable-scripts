#!/usr/bin/env bash
#
# Script to build Vim from github and installs under ~/.portable-scripts/.
TOOL_NAME="Vi Improved (vim/gvim)"
TOOL_INFO="Go to 'https://vim.org' for more information."
TOOL_SRC="vim"
TOOL_URL="https://github.com/vim/vim.git"
GENERATOR="cmake"

function Realpath() {
  if [[ $# == 0 ]]; then set - .; fi
  /usr/bin/perl '-MCwd(abs_path)' -le '$p=abs_path(join(q( ),@ARGV));print $p if -e $p' "$*"
}

SCRIPT="$(dirname $(Realpath "$0"))/utils.bash"
if [[ -x "${SCRIPT}" ]]; then
  # shellcheck source=utils.bash
  source "${SCRIPT}" "$0"
else
  echo "Error: Missing ${SCRIPT}" 1>&2; exit 1
fi

SetupLogdir "$0"

GetBuildOpts "$0" "$@"
ConfirmBuildOpts || exit

Create_and_Cd "${SRC}"
GetSource_and_Cd "${TOOL_SRC}" "${TOOL_URL}"

Report_info "Configuring ${TOOL_NAME}"
_do ./configure --prefix "${APPS}"
Report_info "Making ${TOOL_NAME}"
_do make
Report_info "Installing ${TOOL_NAME}"
_do make install

Cleanup_Source "${TOOL_SRC}"

IMPLEMENTATION=<<'EOF'
-------------------------------------------------------------------------------
+ Built Vim under ${HOME}/.portable-scripts/src/vim.
+ Installed Vim under ${HOME}/.portable-scripts
+ To use, prepend ${HOME}/.portable-scripts/bin to your path appropriately.
+ For bash modify `.bashrc` by adding: `PATH="${HOME}/.portable-scripts/bin:$PATH"`
+ When satisfied, you may:

  1. Clean-up the build directly with `cd ${HOME}/.portable-scripts/src/vim && make clean`
  - OR -
  2. Remove Vim entirely with `rm -fr ${HOME}/.portable-scripts/src/vim`

+ To share with others: `chmod a+x ${HOME} && chmod a+rx ${HOME}/.portable-scripts`, and let
  them know to add to `${HOME}/.portable-scripts/bin` to their paths.
-------------------------------------------------------------------------------

EOF
