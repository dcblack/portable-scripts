#!/usr/bin/env bash
#
#$Info: build-brew - install brew on macos or linux. $

function Install_brew()
{
  local TOOL_NAME="build-brew" VERSION=0.1.0 HELP_TEXT='
Name
----

build-brew -- installs brew on macOS or Linux

Synopsis
--------

```bash
build-brew --help
build-brew --version
build-brew [--force]
```

'
  local FORCE=0
  for arg in "$@"; do
    case "${arg}" in
      --help|-h)
        if builtin command -v glow 1>/dev/null 2>&1; then
          glow -p <<<"${HELP_TEXT}" #>>>
        elif builtin command -v less 1>/dev/null 2>&1; then
          less -X <<<"${HELP_TEXT}" #>>>
        else
          cat <<<"${HELP_TEXT}"
        fi
        return 0
        ;;
      --version|-V)
        echo "${TOOL_NAME} version ${VERSION}"
        return 0
        ;;
      --force)
        FORCE=1
        ;;
      *)
        echo "ERROR: Unknown option: ${arg}"
        return 1
        ;;
    esac
  done
  if builtin command -v brew 1>/dev/null 2>&1; then
    if [[ ${FORCE} != 1 ]]; then
      echo "Already installed. Use --force to reinstall"
      return 1
    fi
  fi
  local OS REV
  OS="$(uname -s)"
  REV="$(uname -r)"
  HW="$(uname -m)"
  case "${OS}-${REV}" in
    Darwin*)
      #shellcheck disable=2312
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      if ! builtin command -v brew >/dev/null 2>&1; then
        if [[ "${HW}" =~ arm64 ]]; then
          #shellcheck disable=2016
          (echo; echo 'eval "$(/opt/homebrew/bin/brew shellenv)"') >> ~/.zprofile
        fi
        #shellcheck disable=2312
        eval "$(/opt/homebrew/bin/brew shellenv)"
      fi
      ;;
    Linux*WSL2) # Assume Linux on WSL2
      sudo apt update -y
      sudo apt install -y build-essential procps curl file git
      sudo apt autoremove -y
      sudo rm /etc/resolv.conf
      sudo bash -c 'echo "nameserver 8.8.8.8" > /etc/resolv.conf'
      sudo bash -c 'echo "[network]" >> /etc/wsl.conf'
      sudo bash -c 'echo "generateResolvConf = false" >> /etc/wsl.conf'
      #shellcheck disable=2312
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      ;;
    Linux*) # Assume Linux on WSL2
      sudo apt update -y
      sudo apt install -y build-essential procps curl file git
      sudo apt autoremove -y
      #shellcheck disable=2312
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      ;;
    *)
      printf "\033[1;91mError: Unknown OS for brew installation\033[0m\n"
      return 1
      ;;
  esac
}

Install_brew "$@"
